model Category {
  id     Int     @id @default(autoincrement())
  name   String
  pieces Piece[]
}

model Piece {
  id          Int            @id @default(autoincrement())
  name        String
  stock       Int
  threshold   Int
  price       Float
  categoryId  Int
  category    Category       @relation(fields: [categoryId], references: [id],onDelete: Cascade)
  orders      Order[]
  interventions Intervention[]
}

model Intervention {
  id              Int            @id @default(autoincrement())
  description String
  startDate       DateTime
  endDate         DateTime
  price       Float         // Changed from Decimal to Float for simplicity
  status          Status
  appointmentId   Int
  appointment     Appointment    @relation(fields: [appointmentId], references: [id],onDelete: Cascade)
  pieceId         Int?
  piece           Piece?          @relation(fields: [pieceId], references: [id],onDelete: Cascade)
}

model Order {
  id          Int     @id @default(autoincrement())
  date        DateTime
  status      Status
  quantity    Int 
  pieceId     Int
  piece       Piece   @relation(fields: [pieceId], references: [id],onDelete: Cascade)
  userId      Int
  user        User    @relation(fields: [userId], references: [id],onDelete: Cascade)
}
